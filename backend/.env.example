# Copy this file to .env and fill in real values

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/fulokoja_recruitment

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret

# Port the API server runs on
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Optional: SMTP settings for sending real emails (password reset links, etc).
# If left blank, reset links are printed to the backend console instead so
# you can still test the feature before setting up a real email account.
# Example for a Gmail account (use an "App Password", not your normal password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USER=youraddress@gmail.com
#   EMAIL_PASS=your16characterapppassword
#   EMAIL_FROM=youraddress@gmail.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
